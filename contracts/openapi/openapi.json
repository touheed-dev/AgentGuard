{
  "components": {
    "schemas": {
      "AuditVerificationResponse": {
        "additionalProperties": false,
        "properties": {
          "checked_events": {
            "title": "Checked Events",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "verified",
          "checked_events"
        ],
        "title": "AuditVerificationResponse",
        "type": "object"
      },
      "Decision": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "default": "",
            "title": "Agent Id",
            "type": "string"
          },
          "capability_result": {
            "additionalProperties": true,
            "title": "Capability Result",
            "type": "object"
          },
          "decision": {
            "$ref": "#/components/schemas/DecisionOutcome"
          },
          "execution_id": {
            "default": "",
            "title": "Execution Id",
            "type": "string"
          },
          "parameter_result": {
            "additionalProperties": true,
            "title": "Parameter Result",
            "type": "object"
          },
          "policy_results": {
            "additionalProperties": true,
            "title": "Policy Results",
            "type": "object"
          },
          "reasons": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "risk": {
            "additionalProperties": true,
            "title": "Risk",
            "type": "object"
          },
          "task_id": {
            "default": "",
            "title": "Task Id",
            "type": "string"
          },
          "tool_name": {
            "default": "",
            "title": "Tool Name",
            "type": "string"
          },
          "trace_id": {
            "default": "",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "decision"
        ],
        "title": "Decision",
        "type": "object"
      },
      "DecisionOutcome": {
        "enum": [
          "ALLOW",
          "WARN",
          "REQUIRE_APPROVAL",
          "BLOCK"
        ],
        "title": "DecisionOutcome",
        "type": "string"
      },
      "ExecutionResponse": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ExecutionResponse",
        "type": "object"
      },
      "ExecutionState": {
        "enum": [
          "REQUESTED",
          "AUTHORIZED",
          "BLOCKED",
          "APPROVAL_PENDING",
          "APPROVED",
          "EXECUTING",
          "SUCCEEDED",
          "FAILED",
          "CANCELLED",
          "UNKNOWN_RESULT"
        ],
        "title": "ExecutionState",
        "type": "string"
      },
      "GatewayActionRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "minLength": 1,
            "title": "Agent Id",
            "type": "string"
          },
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "execution_id": {
            "minLength": 1,
            "title": "Execution Id",
            "type": "string"
          },
          "idempotency_key": {
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "lifecycle_state": {
            "$ref": "#/components/schemas/ExecutionState",
            "default": "REQUESTED"
          },
          "request_id": {
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "task_id": {
            "minLength": 1,
            "title": "Task Id",
            "type": "string"
          },
          "token": {
            "minLength": 1,
            "title": "Token",
            "type": "string"
          },
          "tool_name": {
            "minLength": 1,
            "title": "Tool Name",
            "type": "string"
          },
          "trace_id": {
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "execution_id",
          "agent_id",
          "tool_name",
          "task_id",
          "trace_id",
          "idempotency_key",
          "token"
        ],
        "title": "GatewayActionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "mode"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Reason": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ReasonCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity",
          "source"
        ],
        "title": "Reason",
        "type": "object"
      },
      "ReasonCode": {
        "enum": [
          "AGENT_DISABLED",
          "AGENT_QUARANTINED",
          "CAPABILITY_DENIED",
          "TOOL_UNREGISTERED",
          "SCHEMA_INVALID",
          "PATH_TRAVERSAL",
          "SENSITIVE_RESOURCE",
          "DESTINATION_NOT_ALLOWLISTED",
          "TASK_INCONSISTENT",
          "COMM_PATH_DENIED",
          "HONEY_ASSET_TOUCHED",
          "CUMULATIVE_RISK_HIGH",
          "BREAKER_TRIPPED",
          "REQUEST_REPLAYED",
          "TOKEN_INVALID",
          "APPROVAL_STALE",
          "EXECUTION_DUPLICATE",
          "RESULT_UNKNOWN"
        ],
        "title": "ReasonCode",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Phase 1 deterministic security Gateway.",
    "title": "AgentGuard Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions/evaluate": {
      "post": {
        "operationId": "evaluate_action_actions_evaluate_post",
        "parameters": [
          {
            "in": "query",
            "name": "track_request",
            "required": false,
            "schema": {
              "default": false,
              "title": "Track Request",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatewayActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate Action",
        "tags": [
          "actions"
        ]
      }
    },
    "/actions/execute": {
      "post": {
        "operationId": "execute_action_actions_execute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatewayActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Execute Action",
        "tags": [
          "actions"
        ]
      }
    },
    "/audit/verify": {
      "get": {
        "operationId": "verify_audit_audit_verify_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditVerificationResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Verify Audit",
        "tags": [
          "audit"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
