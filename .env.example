# AgentGuard Runtime & Environment Configuration
AGENTGUARD_ENV=replay
LLM_PROVIDER=replay
LLM_MODE=replay
GROQ_MODEL=
GROQ_API_KEY=
DATABASE_URL=postgresql+asyncpg://agentguard:agentguard@postgres:5432/agentguard
POSTGRES_PASSWORD=
VALKEY_URL=redis://valkey:6379/0

# ==============================================================================
# Live Threat Intelligence Providers (External Feeds & API Keys)
# NOTE: CISA KEV and URLhaus work out-of-the-box via public feeds.
# Optional commercial keys enhance rate limits and multi-engine depth.
# ==============================================================================

# AbuseIPDB API Key (https://www.abuseipdb.com/api) - IP abuse confidence scoring
ABUSEIPDB_API_KEY=

# AlienVault OTX API Key (https://otx.alienvault.com/api) - Threat pulses & malware families
OTX_API_KEY=

# VirusTotal API v3 Key (https://www.virustotal.com/gui/my-apikey) - Multi-engine scanning
VIRUSTOTAL_API_KEY=

# URLhaus (abuse.ch) Auth Key (https://urlhaus.abuse.ch/api/) - Optional higher rate limit
URLHAUS_API_KEY=

# Shodan API Key (https://account.shodan.io/) - Port, CVE & host intelligence
SHODAN_API_KEY=

# GreyNoise API Key (https://viz.greynoise.io/account) - Noise vs scanner actor tagging
GREYNOISE_API_KEY=
